# SQLite file. Default: data/novel_workbench.db
NOVEL_DB_PATH=data/novel_workbench.db
NOVEL_SEED_DEMO=1

# AI defaults to safe local demo mode. For a real provider, set NOVEL_AI_KIND.
NOVEL_AI_KIND=demo
NOVEL_AI_MODEL=
NOVEL_AI_BASE_URL=
NOVEL_AI_API_KEY_ENV=

# Example for freellm-gateway / OpenAI-compatible:
# NOVEL_AI_KIND=freellm-gateway
# NOVEL_AI_MODEL=your-model-alias
# NOVEL_AI_BASE_URL=http://127.0.0.1:3000/v1
# NOVEL_AI_API_KEY_ENV=FREELLM_GATEWAY_API_KEY


# Optional checkout path for the separate novel content repository.
# Example: D:/WorkSpace/slow-world-novel
NOVEL_CONTENT_ROOT=
