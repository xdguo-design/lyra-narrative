# SQLite file. Default: data/novel_workbench.db
NOVEL_DB_PATH=data/novel_workbench.db
NOVEL_SEED_DEMO=1

# Preferred configuration:
# create named Provider profiles from the Lyra Narrative UI.
# Provider names are user-defined; protocol is selected separately.
#
# The variables below are fallback runtime configuration only, useful for
# headless/local runs when no default Provider profile exists.
NOVEL_AI_PROVIDER_NAME=workbench
NOVEL_AI_KIND=demo
NOVEL_AI_MODEL=
NOVEL_AI_BASE_URL=
NOVEL_AI_API_KEY_ENV=

# Example fallback for any OpenAI-compatible endpoint:
# NOVEL_AI_PROVIDER_NAME=主写作
# NOVEL_AI_KIND=openai-compatible
# NOVEL_AI_MODEL=your-model-id
# NOVEL_AI_BASE_URL=https://provider.example.com/v1
# NOVEL_AI_API_KEY_ENV=MY_PROVIDER_API_KEY

# The actual secret value is set separately and is never committed:
# MY_PROVIDER_API_KEY=...

# Optional checkout path for the separate novel content repository.
# Example: D:/WorkSpace/slow-world-novel
NOVEL_CONTENT_ROOT=
