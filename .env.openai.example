# NarrativeOS OpenAI GPT-5.6 Sol production profile
# Copy values into your local environment; never commit the API key itself.

NOVEL_AI_KIND=openai
NOVEL_AI_MODEL=gpt-5.6-sol
NOVEL_AI_BASE_URL=https://api.openai.com/v1
NOVEL_AI_API_KEY_ENV=OPENAI_API_KEY
NOVEL_AI_REASONING_EFFORT=high
NOVEL_AI_MAX_TOKENS=8000

# Set separately in your shell or secret store:
# OPENAI_API_KEY=...
